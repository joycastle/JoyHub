# JoyHub light production overlay for compose.release.yml
# cp .env.light.release.example .env.release && vim .env.release

# --- Images (build from this fork; do NOT use upstream ghcr.io for JoyHub) ---
SKILLHUB_VERSION=main
SKILLHUB_SERVER_IMAGE=ghcr.io/joycastle/skillhub-server
SKILLHUB_WEB_IMAGE=ghcr.io/joycastle/skillhub-web
SKILLHUB_SCANNER_IMAGE=ghcr.io/joycastle/skillhub-scanner
JOYHUB_DEPLOYMENT_RUNNER_IMAGE=ghcr.io/joycastle/joyhub-deployment-runner

# --- Public URL (no trailing slash) ---
# Use your domain if you reverse-proxy through existing nginx, e.g.:
#   SKILLHUB_PUBLIC_BASE_URL=https://joyhub.your-company.com
# Or bind web to a high port and use IP directly:
#   SKILLHUB_PUBLIC_BASE_URL=http://13.229.10.38:18080
SKILLHUB_PUBLIC_BASE_URL=https://joyhub.example.com

# --- Ports: keep postgres/redis on 127.0.0.1; pick free host ports ---
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=15432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=16379
WEB_PORT=18080
API_PORT=18081
SESSION_COOKIE_SECURE=true

# --- Storage: local volume is enough for a single-machine JoyHub ---
SKILLHUB_STORAGE_PROVIDER=local

# --- Database ---
POSTGRES_DB=skillhub
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=change-this-postgres-password

# --- Required secrets ---
SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=replace-with-random-download-secret-32-bytes
HERMES_SKILLHUB_JWT_SECRET=replace-with-same-secret-as-hermes-agent
HERMES_SKILLHUB_JWT_ISSUER=hermes-agent

# --- Static application deployment ---
JOYHUB_RUNNER_TOKEN=replace-with-random-runner-token
JOYHUB_DEPLOYMENT_PUBLIC_ORIGIN=https://static.joyhub.example.com
JOYHUB_DEPLOYMENT_PATH_PREFIX=/apps

# --- Feishu OAuth (Web login) ---
OAUTH2_FEISHU_CLIENT_ID=cli_xxx
OAUTH2_FEISHU_CLIENT_SECRET=xxx
OAUTH2_FEISHU_SCOPE=contact:user.base:readonly

# --- JoyHub light behavior ---
SKILLHUB_API_TOKENS_ENABLED=false
SKILLHUB_GOVERNANCE_ENABLED=false
SKILLHUB_PROFILE_MACHINE_REVIEW_ENABLED=false
SKILLHUB_PROFILE_HUMAN_REVIEW_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false

# --- Scanner (optional LLM keys) ---
SKILLHUB_SECURITY_SCANNER_ENABLED=true
SKILL_SCANNER_LLM_API_KEY=
SKILL_SCANNER_LLM_BASE_URL=
SKILL_SCANNER_LLM_MODEL=
